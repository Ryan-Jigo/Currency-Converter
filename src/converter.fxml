<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controller"
      spacing="15" alignment="CENTER"
      stylesheets="@style.css">

   <Label text="Currency Converter" styleClass="label" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

   <HBox spacing="10">
      <Label text="From:" styleClass="label"/>
      <ComboBox fx:id="fromCurrency" styleClass="combo-box"/>
   </HBox>

   <HBox spacing="10">
      <Label text="To:" styleClass="label"/>
      <ComboBox fx:id="toCurrency" styleClass="combo-box"/>
   </HBox>

   <HBox spacing="10">
      <Label text="Amount:" styleClass="label"/>
      <TextField fx:id="amountField" styleClass="text-field"/>
   </HBox>

   <Button text="Convert" onAction="#handleConvert" styleClass="button"/>

   <Label fx:id="result" id="resultLabel"/>

</VBox>


